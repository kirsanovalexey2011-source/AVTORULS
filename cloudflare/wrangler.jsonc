{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "garage78-booking",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "vars": {
    "ALLOWED_ORIGINS": "https://kirsanovalexey2011-source.github.io"
  },
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "178078001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
